# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.env.*
.env

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Additional recommended ignores ---
# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# Editor directories and files
.vscode/
*.code-workspace
*.sublime-workspace
*.sublime-project

# Flutter / Dart
.dart_tool/
/.packages
/.flutter-plugins
/.flutter-plugins-dependencies
pubspec.lock

# Local configuration files
local.properties
*.iml

# Android specific
/.gradle/
/android/**/build/
/android/**/captures/
/android/app/*.keystore

# iOS specific
/ios/Pods/
/ios/Runner.xcworkspace/
**/ios/Flutter/Generated.xcconfig

# Windows specific
/windows/Flutter/ephemeral/
/windows/runner/**/Release/
/windows/runner/**/Debug/

# macOS specific
/macos/Flutter/ephemeral/
/macos/Runner/**/Release/
/macos/Runner/**/Debug/

# Build outputs and generated files
/build/
/flutter_assets/
/gen/

# Logs, test outputs
/logs/
*.log
.flutter-plugins

# Sensitive files
*.keystore
*.p12
*.jks

# Coverage
/coverage/

# Ignore generated plugin registrant files
**/GeneratedPluginRegistrant.*
